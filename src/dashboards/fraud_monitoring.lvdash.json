{
  "datasets": [
    {
      "name": "recall",
      "displayName": "Recall (labels arrive 7 days late)",
      "queryLines": [
        "SELECT date, value AS recall FROM daily_metrics WHERE metric = 'recall' ORDER BY date "
      ]
    },
    {
      "name": "savings",
      "displayName": "Net savings ratio",
      "queryLines": [
        "SELECT date, value AS savings_ratio FROM daily_metrics WHERE metric = 'savings_ratio' ORDER BY date "
      ]
    },
    {
      "name": "alert_rate",
      "displayName": "Alert rate",
      "queryLines": [
        "SELECT date, value AS alert_rate FROM daily_metrics WHERE metric = 'alert_rate' ORDER BY date "
      ]
    },
    {
      "name": "score_psi",
      "displayName": "Score PSI",
      "queryLines": [
        "SELECT date, value AS psi_score FROM daily_metrics WHERE metric = 'psi_score' ORDER BY date "
      ]
    },
    {
      "name": "feature_psi",
      "displayName": "Top 6 feature PSI",
      "queryLines": [
        "SELECT date, metric AS feature, value AS psi FROM daily_metrics WHERE metric IN (SELECT metric FROM daily_metrics WHERE metric LIKE 'psi_%' AND metric <> 'psi_score' GROUP BY metric ORDER BY max(value) DESC LIMIT 6) ORDER BY date "
      ]
    },
    {
      "name": "alerts",
      "displayName": "Alerts",
      "queryLines": [
        "SELECT date, scenario, severity, rule, round(value, 3) AS value, round(`limit`, 3) AS limit_value FROM alerts ORDER BY date DESC, severity "
      ]
    }
  ],
  "pages": [
